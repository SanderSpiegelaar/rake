{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RakeConfig",
  "type": "object",
  "properties": {
    "dark_mode": {
      "type": "boolean",
      "default": false
    },
    "debug": {
      "type": "boolean",
      "default": false
    },
    "height": {
      "type": "integer",
      "format": "uint32",
      "default": 780,
      "minimum": 0
    },
    "hide_title_bar": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "inject": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_height": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "min_width": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "safe_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "minimum": 0
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string"
    },
    "user_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "default": 1200,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "url"
  ]
}
